# Copy to .env:  make init
# Region: ap-southeast-1 is closest to VN and has all SOA-C03 services.
AWS_REGION=ap-southeast-1

# Filled automatically by `make init` from aws sts get-caller-identity.
# Break scripts refuse to run if this does not match the current account.
LAB_ACCOUNT_ID=123456789012

# Prefix for every resource and tag.
LAB_PREFIX=soa-c03

# Hard deadline. Every stack/resource is tagged ExpiryDate=this value.
# Cleanup day: 2026-12-01 (credits expire 2026-12-03).
EXPIRY_DATE=2026-12-01

# Optional. SNS email subscription needs manual confirmation once.
ALERT_EMAIL=you@example.com

# Safety interlock. `bin/lab break` refuses unless this is yes.
ALLOW_BREAK=no

# Beginner gate: require `./bin/lab brief <id> --confirm` before break.
# Set yes if you are new; the AI mentor should still do the brief.
REQUIRE_BRIEF=no

# CloudFormation stack names (change only if you know why).
CORE_STACK=soa-c03-core
APP_STACK=soa-c03-app
