LAB_ID=12
LAB_TITLE="Event-driven remediation: EC2 stopped → Lambda start"
DOMAIN="D3 Automation 22%"
MINUTES=150
COST="low"
NEEDS_APP="yes"
HINT1="Event có tới rule không? Rule có gọi Lambda không? Lambda có quyền start không?"
